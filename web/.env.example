# CloudAGI x402 Payment Configuration
# Copy to .env and fill in your values

# Your wallet address that receives USDC payments
SELLER_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS

# x402 Facilitator URL (Coinbase CDP or community)
FACILITATOR_URL=https://x402.org/facilitator

# Network: base-sepolia (testnet) or base (mainnet)
X402_NETWORK=base-sepolia

# GitHub OAuth (existing)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=cloudagi-dev-secret

# Server
PORT=3000
